# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Responses-compatible Provider. Legacy ARK_* aliases remain readable, but
# new deployments use these Provider-neutral variables.
MODEL_PROVIDER=ark
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_ID=ep-replace-with-responses-endpoint
MODEL_API_KEY=replace-with-a-scoped-demo-key
MODEL_WIRE_API=responses

# CommitGate (enabled by default in this product demo)
COMMITGATE_ENABLED=true
# COMMITGATE_CONTROL_ROOT=/absolute/path/outside/agent/workspaces
COMMITGATE_TRUSTED_CHECKS_DIR=eval/trusted-checks
COMMITGATE_MAX_CHANGED_FILES=100
COMMITGATE_MAX_CHANGED_BYTES=1048576
COMMITGATE_MAX_SINGLE_FILE_BYTES=262144
COMMITGATE_VERIFIER_TIMEOUT_MS=30000
COMMITGATE_VERIFIER_MAX_OUTPUT_BYTES=65536
COMMITGATE_MAX_UNIQUE_SNAPSHOTS=20
COMMITGATE_MAX_SNAPSHOT_BYTES=536870912
# Kernel cap for the single-active-run candidate/export exchange tmpfs.
COMMITGATE_EXCHANGE_BYTES=536870912
COMMITGATE_EXCHANGE_INODES=100000

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Direct-process development compatibility. The formal `npm run demo` product
# topology overrides this block: it forces Runtime Broker + isolated Docker
# Agent/Verifier containers and never treats local-process as release evidence.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider for direct local development only. `npm run demo` forces
# `broker`; local-process is not a protected CommitGate production path.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
