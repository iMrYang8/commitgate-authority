ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE} AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY apps/server apps/server
RUN npm run build -w @launchpad/server
RUN npm prune --omit=dev

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends attr acl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 20000 commitgate-workspace \
    && groupadd --gid 20001 commitgate-transition-rpc \
    && useradd --uid 10001 --gid 20000 --no-create-home --shell /usr/sbin/nologin commitgate \
    && mkdir -p /var/lib/commitgate/workspaces /var/lib/commitgate/control \
       /var/lib/commitgate/inbox /run/commitgate \
    && chown -R 10001:20000 /var/lib/commitgate \
    && chown -R 10001:20001 /run/commitgate

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/server/package.json ./apps/server/package.json
COPY --from=build /app/apps/server/dist ./apps/server/dist

USER 10001:20000
ENV COMMITGATE_TRANSITION_WORKER=enabled
ENV TRANSITION_WORKER_WORKSPACE_ROOT=/var/lib/commitgate/workspaces
ENV TRANSITION_WORKER_CONTROL_ROOT=/var/lib/commitgate/control
ENV TRANSITION_WORKER_INBOX_ROOT=/var/lib/commitgate/inbox
ENV TRANSITION_WORKER_SOCKET=/run/commitgate/transition/transition-worker.sock

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["node", "apps/server/dist/transition-worker/cli.js", "health"]

CMD ["node", "apps/server/dist/transition-worker/main.js"]
