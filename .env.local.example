# Copy this file to .env.local. Never commit the real file. Ark values below
# are one Responses-compatible example; another adapter may replace all five
# MODEL_* values without changing CommitGate semantics.
MODEL_PROVIDER=ark
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_ID=ep-replace-with-responses-endpoint
MODEL_API_KEY=replace-with-a-scoped-demo-key
MODEL_WIRE_API=responses
COMMITGATE_POLICY_PROFILE=deployment-protected

# Kernel-bounded ephemeral candidate/export exchange (single active Agent run).
COMMITGATE_EXCHANGE_BYTES=536870912
COMMITGATE_EXCHANGE_INODES=100000
